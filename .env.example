# Server
NODE_ENV=development
PORT=5000
# Production API URL for asset links (never use localhost in stored image URLs)
API_URL=https://api.fciseller.com

# AWS S3 — all uploads stored in S3 (no local disk)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=hopscotch-bt
# Optional: direct S3/CDN base URL (e.g. https://hopscotch-bt.s3.ap-south-1.amazonaws.com)
# When set, upload URLs use this instead of API_URL/api/uploads/
S3_PUBLIC_BASE_URL=

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hopscotch_db?schema=public"

# JWT - Separate keys for each application
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin Panel JWT Secrets
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_REFRESH_SECRET=your-admin-refresh-secret-change-in-production

# Website JWT Secrets
WEBSITE_JWT_SECRET=your-website-jwt-secret-change-in-production
WEBSITE_REFRESH_SECRET=your-website-refresh-secret-change-in-production

# Mobile App JWT Secrets
MOBILE_JWT_SECRET=your-mobile-jwt-secret-change-in-production
MOBILE_REFRESH_SECRET=your-mobile-refresh-secret-change-in-production

# Firebase (FCM)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Payment Keys
RAZORPAY_KEY_ID=rzp_test_SqtWwbyJFAgNBK
RAZORPAY_KEY_SECRET=V21UMKXR02Jg28g8tvaxWU5g

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@yourdomain.com

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=https://admin.fciseller.com,https://fciseller.com,https://www.fciseller.com,http://localhost:3000,http://localhost:3001

# Shiprocket
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_api_user_email
SHIPROCKET_PASSWORD=your_api_user_password

